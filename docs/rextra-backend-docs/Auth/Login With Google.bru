meta {
  name: Login With Google
  type: http
  seq: 2
}

post {
  url: {{host}}/api/v1/auth/google
  body: json
  auth: inherit
}

body:json {
  {
    "id_token": "" // dari firebase
  }
}

script:post-response {
  const token = res('data.access_token')
  bru.setEnvVar('token',token)
}

settings {
  encodeUrl: true
}

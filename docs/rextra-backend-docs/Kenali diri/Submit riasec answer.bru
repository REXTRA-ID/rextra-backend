      5, 4, 3, 4, 5, 3, 4, 5, 3, 4, 5, 2,   
      4, 5, 3, 4, 5, 4, 3, 4, 5, 3, 4, 5,   
      5, 4, 4, 3, 4, 5, 3, 4, 5, 4, 3, 5,   
      4, 3, 5, 4, 3, 5, 4, 4, 5, 3, 4, 5    
    ]
  }
}
